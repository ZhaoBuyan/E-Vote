PORT=3000
JWT_SECRET=your_super_secret_key_change_me
JWT_EXPIRES_IN=24h

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=e_vote

# DeepSeek API（可选，留空则使用 Mock 模式）
DEEPSEEK_API_KEY=your_deepseek_api_key_optional

# Redis 配置（使用 Docker Compose 时默认 localhost:6379）
REDIS_HOST=localhost
REDIS_PORT=6379

# 跨域白名单（逗号分隔；留空表示只允许同源）
CORS_ORIGIN=

# 仅在确实位于反向代理之后时设置，例如 1（信任一层代理）
TRUST_PROXY=